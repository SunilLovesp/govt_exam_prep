# Local development port. AWS Elastic Beanstalk provides PORT automatically.
PORT=5000
NODE_ENV=development

# Comma-separated allowed origins. Use * while testing, then lock it down.
CORS_ORIGIN=*

# MongoDB Atlas connection string
# Get from: Atlas Dashboard → Cluster → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/examprep?retryWrites=true&w=majority

# JWT secret — use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret

# Admin credentials for the admin panel
ADMIN_EMAIL=admin@examprep.com
ADMIN_PASSWORD=change_this_password

# AWS S3 — for PYQ PDF storage
# On AWS, prefer an Elastic Beanstalk instance profile/IAM role with S3 access.
# For local development only, you can use access keys.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_S3_BUCKET=your-examprep-bucket-name
